#!/bin/sh
set -eu

if [ "$#" -lt 1 ]; then
  echo "用法：./scripts/restore-drill SNAPSHOT [--sha256 DIGEST]" >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(dirname -- "${SCRIPT_DIR}")
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${PROJECT_ROOT}/apps/pipeline/src"
exec python3 -B -m knowledge_os.operations --root "${PROJECT_ROOT}" \
  restore-drill "$@"

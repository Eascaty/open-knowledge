{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eascaty.github.io/personal-knowledge-os/contracts/canonical-v1.schema.json",
  "title": "Personal Knowledge OS canonical data v1",
  "description": "跨 Python、Web、Java 与未来 App 的规范化知识数据边界。",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "site",
    "root",
    "nodes",
    "documents",
    "relations",
    "stats"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string" },
    "site": { "$ref": "#/$defs/site" },
    "root": { "$ref": "#/$defs/identifier" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "stats": { "$ref": "#/$defs/stats" }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public"]
    },
    "site": {
      "type": "object",
      "required": ["title", "description", "language", "visibility"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "language": { "type": "string", "minLength": 1 },
        "visibility": { "$ref": "#/$defs/visibility" }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "parent_id",
        "name",
        "level",
        "path",
        "locked",
        "summary",
        "visibility",
        "children",
        "direct_document_count",
        "document_count"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "parent_id": { "type": ["string", "null"] },
        "name": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 0 },
        "path": { "$ref": "#/$defs/stringList" },
        "locked": { "type": "boolean" },
        "summary": { "type": "string" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "children": { "$ref": "#/$defs/stringList" },
        "direct_document_count": { "type": "integer", "minimum": 0 },
        "document_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "original_name": { "type": "string" },
        "origin": { "type": "string" },
        "sha256": { "type": "string" },
        "available_locally": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "excerpt", "locator", "source_label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "excerpt": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "source_label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "source_id",
        "title",
        "summary",
        "content",
        "key_points",
        "tags",
        "node_id",
        "path",
        "visibility",
        "status",
        "source",
        "evidence",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source_id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "key_points": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "node_id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/stringList" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "status": { "type": "string" },
        "section_index": { "type": "integer", "minimum": 0 },
        "heading_path": { "$ref": "#/$defs/stringList" },
        "source_line_start": { "type": "integer", "minimum": 1 },
        "source_line_end": { "type": "integer", "minimum": 1 },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "splitter_version": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "from_node_id",
        "to_node_id",
        "type",
        "label",
        "document_id",
        "confidence",
        "visibility",
        "evidence_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from_node_id": { "$ref": "#/$defs/identifier" },
        "to_node_id": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "document_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "visibility": { "$ref": "#/$defs/visibility" },
        "evidence_ids": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "required": ["node_count", "document_count", "relation_count"],
      "properties": {
        "node_count": { "type": "integer", "minimum": 0 },
        "document_count": { "type": "integer", "minimum": 0 },
        "relation_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}

#!/usr/bin/env python3
"""Build a deterministic, allowlisted local product archive (standard library)."""
from __future__ import annotations

import argparse
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import re
import subprocess
import tarfile
import tempfile

ROOT = Path(__file__).resolve().parent.parent
COMMANDS = (
    'kb', 'knowledge-manager', 'run-pipeline', 'doctor', 'backup', 'backup-bundle',
    'verify-backup-bundle', 'restore-backup-bundle', 'restore-drill', 'migrate',
    'import-chat-export', 'package-site', 'verify-site-package', 'preview-site',
    'reclassify', 'publish-plan',
)


def allowed_source(name):
    return (
        name.startswith('apps/pipeline/src/knowledge_os/')
        and (name.endswith('.py') or name == 'apps/pipeline/src/knowledge_os/default_taxonomy.json')
    ) or (
        name.startswith('apps/web/src/') and name.endswith(('.html', '.css', '.js'))
    )


def build(root: Path, output: Path) -> Path:
    tracked = subprocess.check_output(
        ['git', '-C', str(root), 'ls-files', '-z'], text=True
    ).split('\0')
    revision = subprocess.check_output(
        ['git', '-C', str(root), 'rev-parse', 'HEAD'], text=True
    ).strip()
    version = re.search(r'^version = "([0-9]+\.[0-9]+\.[0-9]+)"$',
                        (root / 'pyproject.toml').read_text(), re.M).group(1)
    paths = {name: name for name in tracked if allowed_source(name)}
    paths.update({f'scripts/{name}': f'scripts/{name}' for name in COMMANDS})
    paths.update({name: name for name in (
        '打开知识库.command', 'LICENSE', 'packages/contracts/canonical.schema.json',
        'docs/runbooks/backup-restore.md',
    )})
    paths['README.md'] = 'docs/runbooks/local-install.md'
    paths['examples/java_g1.md'] = 'tests/fixtures/java_g1.md'
    contents = {}
    for destination, relative in sorted(paths.items()):
        source = root / relative
        if any(part.is_symlink() for part in (source, *source.parents)):
            # A symlinked checkout root may be resolved by the caller; members may not escape.
            raise ValueError('local package rejects symbolic links: ' + relative)
        if not source.is_file():
            raise ValueError('local package requires file: ' + relative)
        contents[destination] = source.read_bytes()
    entries = []
    for name, data in contents.items():
        entries.append({'path': name, 'size_bytes': len(data),
                        'sha256': hashlib.sha256(data).hexdigest(),
                        'mode': 0o755 if name.startswith('scripts/') or name.endswith('.command') else 0o644})
    content_hash = hashlib.sha256(json.dumps(entries, sort_keys=True).encode()).hexdigest()
    package_name = f'knowledge-local-{version}-{revision[:8]}-{content_hash[:12]}'
    manifest = {
        'schema_version': 1, 'package_type': 'knowledge-local-product',
        'version': version, 'base_revision': revision, 'content_sha256': content_hash,
        'python_requires': '>=3.9', 'bundled_python': False,
        'platforms': ['macOS', 'Linux'], 'data_included': False,
        'files': entries,
    }
    contents['local-package.json'] = (json.dumps(manifest, ensure_ascii=False, indent=2) + '\n').encode()
    modes = {entry['path']: entry['mode'] for entry in entries}
    output.mkdir(parents=True, exist_ok=True)
    destination = output / (package_name + '.tar.gz')
    checksum = destination.with_name(destination.name + '.sha256')
    if destination.is_symlink() or checksum.is_symlink():
        raise ValueError('local package rejects symbolic output paths')
    with tempfile.NamedTemporaryFile(prefix='.local-package-', dir=output, delete=False) as handle:
        temporary = Path(handle.name)
        try:
            with gzip.GzipFile(fileobj=handle, mode='wb', filename='', mtime=0) as compressed:
                with tarfile.open(fileobj=compressed, mode='w', format=tarfile.PAX_FORMAT) as archive:
                    for name, data in sorted(contents.items()):
                        info = tarfile.TarInfo(package_name + '/' + name)
                        info.size = len(data)
                        info.mode = modes.get(name, 0o644)
                        info.mtime = 0
                        archive.addfile(info, io.BytesIO(data))
            handle.flush()
            os.fsync(handle.fileno())
            digest = hashlib.sha256(temporary.read_bytes()).hexdigest()
            if destination.exists() and destination.read_bytes() != temporary.read_bytes():
                raise ValueError('local package destination has different bytes')
            os.replace(temporary, destination)
            destination.chmod(0o644)
            checksum = destination.with_name(destination.name + '.sha256')
            checksum.write_text(digest + '  ' + destination.name + '\n')
        finally:
            temporary.unlink(missing_ok=True)
    return destination


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='生成不含真实资料的完整本地程序包')
    parser.add_argument('--output', type=Path, default=ROOT / 'workspace/exports/private/local-packages')
    args = parser.parse_args()
    print(build(ROOT.resolve(), args.output.expanduser().resolve()))

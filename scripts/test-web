#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(dirname -- "${SCRIPT_DIR}")

cd "${PROJECT_ROOT}"
node --check apps/web/src/data-source.js
node --check apps/web/src/search-utils.js
node --check apps/web/src/related-documents.js
node --check apps/web/src/local-ingest.js
node --check apps/web/src/local-classification.js
node --check apps/web/src/local-review.js
node --check apps/web/src/local-review-queue.js
node --check apps/web/src/app.js
node --check apps/web/src/markdown-reader.js
node --check apps/web/src/reading-history.js
node --check apps/web/src/reading-actions.js
node tests/web/data-source.test.js
node tests/web/search-utils.test.js
node tests/web/related-documents.test.js
node tests/web/local-ingest.test.js
node tests/web/local-classification.test.js
node tests/web/local-review.test.js
node tests/web/local-review-queue.test.js
node tests/web/markdown-reader.test.js
node tests/web/reading-history.test.js
node tests/web/reading-actions.test.js

node --check apps/web/src/first-use.js
node tests/web/first-use.test.js

node tests/web/local-source.test.js

node tests/web/search-ui.test.js
